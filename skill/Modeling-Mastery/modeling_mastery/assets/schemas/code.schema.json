{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modeling-mastery.local/schemas/code.schema.json",
  "title": "Code Recipe",
  "type": "object",
  "required": ["id", "target_id", "target_name", "language", "path", "entrypoint", "source_anchors", "validation_status"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "target_name": {"type": "string", "minLength": 1},
    "target_type": {"type": "string", "enum": ["model", "algorithm", "pipeline"]},
    "language": {"type": "string", "enum": ["python", "matlab"]},
    "variant": {"type": "string", "enum": ["from_scratch", "library", "paper_reproduction", "reference"], "default": "paper_reproduction"},
    "path": {"type": "string"},
    "entrypoint": {"type": "string"},
    "dependencies": {"type": "array", "items": {"type": "string"}, "default": []},
    "input_contract": {"type": "array", "items": {"type": "string"}, "default": []},
    "output_contract": {"type": "array", "items": {"type": "string"}, "default": []},
    "source_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "relationship"],
        "additionalProperties": false,
        "properties": {
          "evidence_id": {"type": "string"},
          "relationship": {"type": "string"},
          "provenance": {
            "type": "string",
            "enum": ["PAPER_EXPLICIT", "PAPER_DERIVED", "AI_INFERRED", "EXTERNAL_REFERENCE", "HEURISTIC"]
          }
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}, "default": []},
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "status"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "kind": {"type": "string", "enum": ["syntax", "unit", "smoke", "property", "numerical", "integration"]},
          "status": {"type": "string", "enum": ["pending", "passed", "failed", "skipped"]},
          "details": {"type": "string", "default": ""}
        }
      },
      "default": []
    },
    "validation_status": {"type": "string", "enum": ["not_checked", "static_passed", "tests_passed", "failed", "manual_review_required"]},
    "limitations": {"type": "array", "items": {"type": "string"}, "default": []},
    "generated_by": {"type": "string", "default": ""},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
