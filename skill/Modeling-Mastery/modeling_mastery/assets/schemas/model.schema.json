{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modeling-mastery.local/schemas/model.schema.json",
  "title": "Model Card",
  "type": "object",
  "required": ["id", "canonical_name", "category", "description", "workflow", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "canonical_name": {"type": "string", "minLength": 1},
    "display_name": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "category": {
      "type": "string",
      "enum": ["evaluation", "optimization", "prediction", "statistics", "graph", "simulation", "mechanism", "clustering", "machine_learning", "game_theory", "data_processing", "other"]
    },
    "task_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "role": {"type": "string", "default": ""},
    "description": {"type": "string"},
    "assumptions": {"type": "array", "items": {"type": "string"}, "default": []},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/ioField"}, "default": []},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/ioField"}, "default": []},
    "equations": {"type": "array", "items": {"$ref": "#/$defs/equation"}, "default": []},
    "workflow": {"type": "array", "items": {"$ref": "#/$defs/workflowStep"}},
    "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}, "default": []},
    "solver_algorithm_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "strengths": {"type": "array", "items": {"type": "string"}, "default": []},
    "weaknesses": {"type": "array", "items": {"type": "string"}, "default": []},
    "use_when": {"type": "array", "items": {"type": "string"}, "default": []},
    "avoid_when": {"type": "array", "items": {"type": "string"}, "default": []},
    "alternatives": {"type": "array", "items": {"type": "string"}, "default": []},
    "combinations": {"type": "array", "items": {"type": "string"}, "default": []},
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time": {"type": "string", "default": "unknown"},
        "space": {"type": "string", "default": "unknown"},
        "notes": {"type": "string", "default": ""}
      },
      "default": {"time": "unknown", "space": "unknown", "notes": ""}
    },
    "validation_methods": {"type": "array", "items": {"type": "string"}, "default": []},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
    "provenance": {"$ref": "#/$defs/provenance"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.5}
  },
  "$defs": {
    "provenance": {
      "type": "string",
      "enum": ["PAPER_EXPLICIT", "PAPER_DERIVED", "AI_INFERRED", "EXTERNAL_REFERENCE", "HEURISTIC"]
    },
    "ioField": {
      "type": "object",
      "required": ["name", "description"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"},
        "shape": {"type": "string", "default": ""},
        "unit": {"type": "string", "default": ""},
        "required": {"type": "boolean", "default": true}
      }
    },
    "equation": {
      "type": "object",
      "required": ["latex", "explanation"],
      "additionalProperties": false,
      "properties": {
        "label": {"type": "string", "default": ""},
        "latex": {"type": "string"},
        "explanation": {"type": "string"},
        "variables": {"type": "array", "items": {"type": "string"}, "default": []},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "default": []},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "workflowStep": {
      "type": "object",
      "required": ["order", "name", "description"],
      "additionalProperties": false,
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "inputs": {"type": "array", "items": {"type": "string"}, "default": []},
        "outputs": {"type": "array", "items": {"type": "string"}, "default": []},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "default": []}
      }
    },
    "parameter": {
      "type": "object",
      "required": ["name", "value", "provenance"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "value": {},
        "description": {"type": "string", "default": ""},
        "range": {"type": "string", "default": ""},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "default": []},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    }
  }
}
