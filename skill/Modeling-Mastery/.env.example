# LLM provider:
# local-agent | codex | claude-code | openai-compatible | anthropic | mock | none
# local-agent automatically tries the locally logged-in Codex CLI, then Claude Code.
MODELING_LLM_PROVIDER=local-agent

# Shared optional model override. For per-CLI overrides, use the fields below.
MODELING_LLM_MODEL=
MODELING_LLM_TIMEOUT=600
MODELING_LLM_MAX_TOKENS=12000
MODELING_LLM_TEMPERATURE=0.0

# -----------------------------------------------------------------------------
# Local Codex CLI: no separate Modeling-Mastery API key is needed.
# First install/login to Codex and confirm `codex --version` works.
# MODELING_CODEX_COMMAND may also be a full path or a command such as `npx codex`.
# -----------------------------------------------------------------------------
MODELING_CODEX_COMMAND=codex
MODELING_CODEX_MODEL=
MODELING_CODEX_SANDBOX=read-only
MODELING_CODEX_APPROVAL_POLICY=never
MODELING_CODEX_EXTRA_ARGS=

# -----------------------------------------------------------------------------
# Local Claude Code CLI: no separate Modeling-Mastery API key is needed.
# First install/login to Claude Code and confirm `claude --version` works.
# The pipeline disables tools for semantic extraction and requests JSON Schema output.
# -----------------------------------------------------------------------------
MODELING_CLAUDE_COMMAND=claude
MODELING_CLAUDE_MODEL=
MODELING_CLAUDE_PERMISSION_MODE=plan
MODELING_CLAUDE_MAX_TURNS=1
MODELING_CLAUDE_MAX_BUDGET_USD=0
MODELING_CLAUDE_BARE=true
MODELING_CLAUDE_EXTRA_ARGS=

# local-agent routing. Supported values: codex, claude-code.
MODELING_LOCAL_AGENT_PREFERENCE=codex,claude-code
MODELING_LOCAL_AGENT_FALLBACK=true
# Optional working directory used by both local CLIs.
MODELING_LOCAL_AGENT_CWD=

# -----------------------------------------------------------------------------
# API providers. Only required when MODELING_LLM_PROVIDER is
# openai-compatible or anthropic.
# -----------------------------------------------------------------------------
MODELING_LLM_API_KEY=
MODELING_LLM_BASE_URL=https://api.openai.com/v1

# Optional Obsidian default vault path
MODELING_VAULT_PATH=

# PDF parser preference: auto | mineru | docling | pymupdf
MODELING_PDF_BACKEND=auto
# MinerU backend: pipeline works on CPU; empty means MinerU default.
MODELING_MINERU_BACKEND=pipeline

# Safety: generated Python is validated before execution.
# Use a disposable container/VM for genuinely untrusted code.
MODELING_CODE_TIMEOUT=30
MODELING_CODE_MEMORY_MB=2048
